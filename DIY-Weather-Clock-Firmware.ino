// Extracts a bare numeric value for "key": <number>  (Open-Meteo returns plain
// numbers, not quoted strings, so this is jsonQuotedValue's numeric sibling).
// fromIndex lets the caller skip past an earlier "units" block that reuses the
// same key names with string values (e.g. "temperature_2m":"°C").
static String jsonNumberValue(const String &s, const char *key, int fromIndex = 0)
{
  String needle = String('"') + key + '"';
  int p = s.indexOf(needle, fromIndex);
  if (p < 0) return "";
  p += needle.length();
  while (p < (int)s.length() && (s[p]==' '||s[p]=='\t'||s[p]=='\n'||s[p]=='\r')) p++;
  if (p >= (int)s.length() || s[p] != ':') return "";
  p++;
  while (p < (int)s.length() && (s[p]==' '||s[p]=='\t'||s[p]=='\n'||s[p]=='\r')) p++;
  int e = p;
  while (e < (int)s.length() && (isDigit(s[e]) || s[e]=='-' || s[e]=='.')) e++;
  return s.substring(p, e);
}

// Pulls the first ISO timestamp out of a "key":["2026-08-17T05:52", ...] array
// and returns just the "05:52" time-of-day part, matching weather_sunrise's format.
static String jsonFirstArrayTime(const String &s, const char *key)
{
  String needle = String('"') + key + "\":[";
  int p = s.indexOf(needle);
  if (p < 0) return "";
  p += needle.length();
  int q1 = s.indexOf('"', p);
  if (q1 < 0) return "";
  int q2 = s.indexOf('"', q1 + 1);
  if (q2 < 0) return "";
  String iso = s.substring(q1 + 1, q2);
  int t = iso.indexOf('T');
  return (t < 0) ? "" : iso.substring(t + 1);
}

// Maps Open-Meteo's WMO weather_code onto an existing WWO code that
// weather_icons.h already knows how to draw, so that file needs no changes.
static int wmoToWwoCode(int wmo)
{
  switch (wmo)
  {
    case 0:  return 113;              // clear sky
    case 1:  return 116;              // mainly clear
    case 2:  return 116;              // partly cloudy
    case 3:  return 122;              // overcast
    case 45: case 48: return 143;     // fog
    case 51: case 53: return 266;     // drizzle
    case 55: return 293;              // dense drizzle
    case 56: return 281;              // freezing drizzle
    case 57: return 284;              // icon sleet  //PB Aug 2026
    case 61: return 296;              // slight rain
    case 63: return 302;              // moderate rain
    case 65: return 308;              // heavy rain
    case 66: return 281;              // freezing rain
    case 67: return 284;              // icon sleet PB Aug 2026
    case 71: return 326;              // slight snow
    case 73: return 332;              // moderate snow
    case 75: return 338;              // heavy snow
    case 77: return 320;              // snow grains
    case 80: return 176;              // slight rain showers
    case 81: return 299;              // moderate rain showers
    case 82: return 356;              // violent rain showers
    case 85: return 326;              // slight snow showers
    case 86: return 371;              // heavy snow showers
    case 95: return 200;              // thunderstorm
    case 96: return 386;              // thunderstorm + slight hail
    case 99: return 389;              // thunderstorm + heavy hail
    default: return 119;              // unknown -> generic cloud
  }
}

