// Returns the raw text of the element at position `index` (0-based) in a JSON
// array value for "key":[ ... ]. Handles both quoted strings (dates) and bare
// numbers uniformly. Requires the key to be followed immediately by '[', so it
// naturally skips past *_units blocks (which hold quoted unit strings, no '[').
static String jsonArrayElementAt(const String &s, const char *key, int index)
{
  String needle = String('"') + key + "\":[";
  int p = s.indexOf(needle);
  if (p < 0) return "";
  p += needle.length();

  for (int i = 0; i < index; i++)
  {
    if (p >= (int)s.length()) return "";
    if (s[p] == '"')
    {
      int q2 = s.indexOf('"', p + 1);
      if (q2 < 0) return "";
      p = q2 + 1;
    }
    else
    {
      while (p < (int)s.length() && s[p] != ',' && s[p] != ']') p++;
    }
    while (p < (int)s.length() && (s[p] == ',' || s[p] == ' ')) p++;
  }

  if (p >= (int)s.length()) return "";
  if (s[p] == '"')
  {
    int q2 = s.indexOf('"', p + 1);
    if (q2 < 0) return "";
    return s.substring(p + 1, q2);
  }
  else
  {
    int e = p;
    while (e < (int)s.length() && (isDigit(s[e]) || s[e] == '-' || s[e] == '.')) e++;
    return s.substring(p, e);
  }
}

// Sakamoto's algorithm, 0 = Sunday. Self-contained, no time.h struct-tm dance
// needed just to get a weekday name from a "YYYY-MM-DD" string.
static String dayAbbrev(int y, int m, int d)
{
  static const int t[] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4};
  int yy = y;
  if (m < 3) yy -= 1;
  int dow = (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7;
  static const char* names[7] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
  return String(names[dow]);
}



