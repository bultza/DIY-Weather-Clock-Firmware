bool getWeatherExpired()
{
  //This function is called only when the getWeather from wttr.in failed. If we have
  //good weather from previous calls (less than 90minutes ago) we do not declare it
  //as not valid
  time_t now = millis();

  if(weather_lastSuccessfulUpdate == 0)
  {
    Log.println("Fetching weather data failed and we never got a valid data :(. Expired!");
    return false; // We never got a valid weather :(
  }

  if(weather_lastSuccessfulUpdate + 5400000UL > now)
  {
    Log.println(F("Weather fetch failed; keeping recent stored data (<90 min old)."));
    return true;  // Last update was < 90 minutes ago, so it is still valid.
  }

  Log.println("Weather data expired! :((((");
  return false;
}

uint32_t getWeatherCounter = 0;

/********************************************************* */
// PB August 2026  replaced getweather() using open-meteo.com
// instead of wttr.in which is more reliable and UK/European
/********************************************************** */

bool getWeather()
{
  if (WiFi.status() != WL_CONNECTED) {
    Log.println(F("WiFi not connected, cannot get weather."));
    return getWeatherExpired();
  }

  // Open-Meteo is HTTPS-only (no plain-HTTP fallback like wttr.in had), but the
  // firmware already talks BearSSL HTTPS for the GitHub update check, so this
  // reuses that exact pattern.
  BearSSL::WiFiClientSecure client;
  client.setInsecure();              // no cert validation, same policy as elsewhere
  client.setBufferSizes(8192, 512);  // response is small JSON but needs the TLS data 

  // TODO: set this to your own location (e.g. via https://www.latlong.net/).
  // Thatcham, Berkshire:
  // This is now a setable config value 
  const float LATITUDE  = 51.399f;
  const float LONGITUDE = -1.244f;

  String url = "https://api.open-meteo.com/v1/forecast?latitude=" + String(LATITUDE, 4)  +
               "&longitude=" + String(LONGITUDE, 4) +
               "&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,surface_pressure" +
               "&daily=sunrise,sunset,weather_code,temperature_2m_max,temperature_2m_min" +
               "&forecast_days=5&timezone=auto" +
               (config_imperial ? "&temperature_unit=fahrenheit&wind_speed_unit=mph"
                                 : "&wind_speed_unit=kmh");


  Log.print(F("Connecting to weather server, URL: "));
  Log.println(url);

  HTTPClient http;
  http.setReuse(false);
  http.useHTTP10(true);              // un-chunked body, clean getString()
  if (!http.begin(client, url))
  {
    Log.println(F("http.begin() failed."));
    return getWeatherExpired();
  }
  http.setTimeout(10000);
  int code = http.GET();
  Log.print(F("Weather HTTP status: ")); Log.println(code);
  if (code != 200)
  {
    http.end();
    return getWeatherExpired();
  }
  String payload = http.getString();
  http.end();

  Log.print(F("Weather raw response: "));
  Log.println(payload);

  int curPos = payload.indexOf("\"current\":{");
  if (curPos < 0) curPos = 0;   // fallback: search whole string if not found

  String tempStr  = jsonNumberValue(payload, "temperature_2m", curPos);
  String humStr   = jsonNumberValue(payload, "relative_humidity_2m", curPos);
  String windStr  = jsonNumberValue(payload, "wind_speed_10m", curPos);
  String pressStr = jsonNumberValue(payload, "surface_pressure", curPos);
  String codeStr  = jsonNumberValue(payload, "weather_code", curPos);

  if (tempStr.length() == 0 || codeStr.length() == 0)
  {
    Log.println(F("Could not parse weather JSON."));
    return getWeatherExpired();
  }
  // Data is valid.
  if (tempStr[0] != '-') tempStr = "+" + tempStr;   // keep the existing +/- convention
  weather_temp = tempStr + (config_imperial ? "F" : "C");

  int wmoCode  = codeStr.toInt();
  weather_code = wmoToWwoCode(wmoCode);   // translate for weather_icons.h
  weather_cond = wmoConditionText(wmoCode);

  weather_hum  = humStr.length()  ? (humStr + "%") : "N/A";
  weather_wind = windStr.length() ? (windStr + (config_imperial ? "mph" : "km/h")) : "N/A";

  if (pressStr.length())
  {
    float hpa;
    weather_press = parseLeadingFloat(pressStr, hpa) ? formatPressureHpa(hpa) : (pressStr + "hPa");
  }
  else weather_press = "N/A";

  String sunRiseStr = jsonFirstArrayTime(payload, "sunrise");
  String sunSetStr  = jsonFirstArrayTime(payload, "sunset");
  if (sunRiseStr.length()) weather_sunrise = sunRiseStr;
  if (sunSetStr.length())  weather_sunset  = sunSetStr;

  // 4-day forecast: daily arrays index 0 is today, so we take indices 1..4.
  weather_daily_valid = true;
  for (int i = 0; i < 4; i++)
  {
    int dayIdx = i + 1;

    String dateStr = jsonArrayElementAt(payload, "time", dayIdx);
    String codeStr = jsonArrayElementAt(payload, "weather_code", dayIdx);
    String maxStr  = jsonArrayElementAt(payload, "temperature_2m_max", dayIdx);
    String minStr  = jsonArrayElementAt(payload, "temperature_2m_min", dayIdx);

    if (dateStr.length() < 10 || codeStr.length() == 0 || maxStr.length() == 0 || minStr.length() == 0)
    {
      weather_daily_valid = false;
      continue;
    }

    int y = dateStr.substring(0, 4).toInt();
    int m = dateStr.substring(5, 7).toInt();
    int d = dateStr.substring(8, 10).toInt();
    weather_daily_label[i] = dayAbbrev(y, m, d);

    weather_daily_code[i] = wmoToWwoCode(codeStr.toInt());

    if (maxStr[0] != '-') maxStr = "+" + maxStr;
    if (minStr[0] != '-') minStr = "+" + minStr;
    weather_daily_max[i] = maxStr + (config_imperial ? "F" : "C");
    weather_daily_min[i] = minStr + (config_imperial ? "F" : "C");
  }

  Log.print(F("Parsed: ")); Log.print(weather_temp); Log.print('|'); Log.print(weather_cond);
  Log.print('|'); Log.print(weather_hum); Log.print('|'); Log.print(weather_wind);
  Log.print('|'); Log.println(weather_press);
  Log.print(F("WMO code=")); Log.print(wmoCode);
  Log.print(F(" -> icon code=")); Log.println(weather_code);

  weather_lastSuccessfulUpdate = millis();   // register when we did get the last weather update
  return true;
}
