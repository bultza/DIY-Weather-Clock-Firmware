// Compact classifier: buckets the translated WWO code (same values weather_code
// already uses) into the handful of shapes drawMiniWeatherIcon() knows how to
// draw, since the 32x32 bitmap icon set is too large for a 4-up strip.
static ForecastIconClass forecastIconClass(int wwo)
{
  switch (wwo)
  {
    case 113: return FI_CLEAR;
    case 116: return FI_PARTCLOUD;
    case 119: case 122: return FI_CLOUD;
    case 143: return FI_FOG;
    case 200: case 386: case 389: return FI_THUNDER;
    case 176: case 266: case 281: case 284: case 293:
    case 296: case 299: case 302: case 308: case 356: return FI_RAIN;
    case 320: case 326: case 332: case 338: case 371: return FI_SNOW;
    default: return FI_CLOUD;
  }
}

static void drawMiniWeatherIcon(int cx, int cy, ForecastIconClass cls)
{
  switch (cls)
  {
    case FI_CLEAR:
      display.drawCircle(cx, cy, 6, SSD1306_WHITE);
      break;
    case FI_PARTCLOUD:
      display.drawCircle(cx - 3, cy - 2, 4, SSD1306_WHITE);
      display.fillRoundRect(cx - 6, cy, 14, 6, 3, SSD1306_WHITE);
      break;
    case FI_CLOUD:
      display.fillRoundRect(cx - 7, cy - 2, 16, 7, 3, SSD1306_WHITE);
      break;
    case FI_RAIN:
      display.fillRoundRect(cx - 7, cy - 5, 16, 7, 3, SSD1306_WHITE);
      display.drawLine(cx - 3, cy + 4, cx - 5, cy + 8, SSD1306_WHITE);
      display.drawLine(cx + 1, cy + 4, cx - 1, cy + 8, SSD1306_WHITE);
      display.drawLine(cx + 5, cy + 4, cx + 3, cy + 8, SSD1306_WHITE);
      break;
    case FI_SNOW:
      display.fillRoundRect(cx - 7, cy - 5, 16, 7, 3, SSD1306_WHITE);
      display.drawPixel(cx - 4, cy + 6, SSD1306_WHITE);
      display.drawPixel(cx, cy + 8, SSD1306_WHITE);
      display.drawPixel(cx + 4, cy + 6, SSD1306_WHITE);
      break;
    case FI_THUNDER:
      display.fillRoundRect(cx - 7, cy - 5, 16, 7, 3, SSD1306_WHITE);
      display.drawLine(cx, cy + 3, cx - 3, cy + 8, SSD1306_WHITE);
      display.drawLine(cx - 3, cy + 8, cx + 1, cy + 8, SSD1306_WHITE);
      display.drawLine(cx + 1, cy + 8, cx - 2, cy + 13, SSD1306_WHITE);
      break;
    case FI_FOG:
      display.drawFastHLine(cx - 8, cy - 3, 16, SSD1306_WHITE);
      display.drawFastHLine(cx - 8, cy,     16, SSD1306_WHITE);
      display.drawFastHLine(cx - 8, cy + 3, 16, SSD1306_WHITE);
      break;
  }
}

void drawForecastScreen()
{
  if (!displayInitialized) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  setDisplayBrightness(calculateDisplayBrightness());
  display.setFont(NULL);

  int16_t x1, y1; uint16_t w, h;
  String title = "4-day outlook";
  display.getTextBounds(title, 0, 0, &x1, &y1, &w, &h);
  display.setCursor((128 - (int)w) / 2, 0);
  display.print(title);

  const int colW = 32;
  for (int i = 0; i < 4; i++)
  {
    int cx = i * colW + colW / 2;

    String lbl = weather_daily_valid ? weather_daily_label[i] : "--";
    display.getTextBounds(lbl, 0, 12, &x1, &y1, &w, &h);
    display.setCursor(cx - (int)w / 2, 12);
    display.print(lbl);

    if (weather_daily_valid)
      drawMiniWeatherIcon(cx, 28, forecastIconClass(weather_daily_code[i]));

    String maxS = weather_daily_valid ? tempForDisplay(weather_daily_max[i]) : "--";
    String minS = weather_daily_valid ? tempForDisplay(weather_daily_min[i]) : "--";

    display.getTextBounds(maxS, 0, 40, &x1, &y1, &w, &h);
    display.setCursor(cx - (int)w / 2, 40);
    display.print(maxS);

    display.getTextBounds(minS, 0, 50, &x1, &y1, &w, &h);
    display.setCursor(cx - (int)w / 2, 50);
    display.print(minS);
  }

  display.display();
}

